<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限：请求 Sun-Panel API 和下载图标 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网络状态：判断是否需要立即刷新 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SunPanelWidgetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SunPanelWidget"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 主入口：设置页（服务器地址、账号、密码） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小部件 Provider -->
        <receiver
            android:name=".SunPanelWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sunpanel.widget.action.REFRESH" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sunpanel_widget_info" />
        </receiver>

        <!-- 注：SunPanelRemoteViewsService 已不再使用（旧版 ListView 方案），保留文件供参考 -->

    </application>

</manifest>