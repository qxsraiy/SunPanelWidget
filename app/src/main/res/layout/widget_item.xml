<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- 背景色层：被代码涂色（半透明卡片底），必须有背景才能被 setBackgroundTintList 着色 -->
    <FrameLayout
        android:id="@+id/widgetItemBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_base" />

    <!-- ② 内容层：图标 + 名称 + 备注，带水波纹（在表层） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?android:attr/selectableItemBackground"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- 图标容器：真实图标 ImageView + 字母兜底 TextView（分组标题时整个 GONE） -->
        <FrameLayout
            android:id="@+id/widgetItemIconBox"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <!-- ⭐ 真实图标（preload 后的 Bitmap） -->
            <ImageView
                android:id="@+id/widgetItemIconImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_icon"
                android:padding="4dp"
                android:visibility="gone" />

            <!-- 字母兜底：无图标/下载失败时显示 -->
            <TextView
                android:id="@+id/widgetItemIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="19sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:visibility="visible" />
        </FrameLayout>

        <!-- 名称 + 备注 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widgetItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetItemDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="#B3FFFFFF"
                android:layout_marginTop="2dp"
                android:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>