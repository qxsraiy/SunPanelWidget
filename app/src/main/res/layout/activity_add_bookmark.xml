<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F3F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:text="收藏到 SunPanel"
            android:textColor="#1F2937"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 分组选择 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="选择分组"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/groupSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner_rounded"
            android:paddingHorizontal="12dp"
            android:dropDownVerticalOffset="2dp"
            android:popupBackground="@drawable/bg_spinner_rounded" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="标题"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_setting_item"
            android:hint="网页标题"
            android:padding="12dp"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="链接地址"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_setting_item"
            android:hint="https://..."
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 图标 Url -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="图标链接（可选，自动获取）"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIcon"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_setting_item"
            android:hint="https://xxx.com/favicon.ico"
            android:inputType="textUri"
            android:padding="12dp"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 描述 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="描述（可选）"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDesc"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_setting_item"
            android:hint="非必需"
            android:padding="12dp"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 保存按钮 -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="保存到 SunPanel"
            android:textSize="16sp"
            android:backgroundTint="#3B82F6"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>