<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F3F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:text="SunPanel 桌面 · 设置"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ① 账号登录 -->
        <LinearLayout
            android:id="@+id/itemLogin"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="账号登录"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配置服务器 / 账号"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="#9CA3AF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ② 打开方式 -->
        <LinearLayout
            android:id="@+id/itemBrowser"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="打开方式"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认 / 指定浏览器"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="#9CA3AF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ③ 颜色配置 -->
        <LinearLayout
            android:id="@+id/itemColor"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="颜色配置"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvColorSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="卡片底色 / 透明度"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="#9CA3AF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ④ 刷新小组件（红色按钮，直接点击刷新，不弹框） -->
        <LinearLayout
            android:id="@+id/itemRefresh"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_refresh_red"
            android:clickable="true"
            android:focusable="true">

            <ProgressBar
                android:id="@+id/refreshProgress"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:indeterminate="true"
                android:indeterminateTint="@android:color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/refreshText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="刷新小组件"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 底部文字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="刷新后自动关闭，无需额外操作"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>