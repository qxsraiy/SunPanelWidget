<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F3F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:text="SunPanel 桌面 · 设置"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ① 账号登录 -->
        <LinearLayout
            android:id="@+id/itemLogin"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="账号登录"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配置服务器 / 账号"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="#9CA3AF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ② 打开方式 -->
        <LinearLayout
            android:id="@+id/itemBrowser"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="打开方式"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认 / 指定浏览器"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="#9CA3AF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ③ 颜色配置 -->
        <LinearLayout
            android:id="@+id/itemColor"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="颜色配置"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvColorSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="卡片底色 / 透明度"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="#9CA3AF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ④ 刷新小组件 -->
        <LinearLayout
            android:id="@+id/itemRefresh"
            style="@style/SettingItem">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="刷新小组件"
                android:textColor="#1F2937"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新桌面数据"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="#9CA3AF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 底部说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="点击上方条目，在弹出的窗口中完成配置"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>