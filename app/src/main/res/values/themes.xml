<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SunPanelWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#FF3B82F6</item>
        <item name="colorPrimaryVariant">#FF2563EB</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF10B981</item>
        <item name="colorSecondaryVariant">#FF059669</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">#FF1E1E2E</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorSurface">#FF2A2A3C</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="android:statusBarColor">#FF1E1E2E</item>
        <item name="android:navigationBarColor">#FF1E1E2E</item>
    </style>

    <!-- 设置页分段标题 -->
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- 设置页分段内容区域 -->
    <style name="SectionContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:padding">12dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- 设置页统一设置项卡片 -->
    <style name="SettingItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_setting_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
</resources>